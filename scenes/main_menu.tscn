theme_override_font_sizes/font_size = 12
text = "The player holding the Double-Six [6-6] MUST play it first in the center of the board. The [6-6] acts as the central spinner and forms the hub of the star."
autowrap_mode = 2

[node name="SecSeb3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSebastopol"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
