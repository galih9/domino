theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "- Domino: Playing your last tile wins the round and scores all pips left in opponents' hands.\n- Blocked Game: If all players pass consecutively, the player with the lowest pip sum wins (scores opponents' pips minus their own pips).\n- Match Target: Rounds continue until a player reaches the target score (50, 100, 150, or 200 pts)."
autowrap_mode = 2

