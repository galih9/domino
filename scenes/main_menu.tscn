[node name="TextP1" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "A standard 52-card deck is used. 28 cards are dealt face-up in 7 overlapping rows forming a pyramid. The remaining 24 cards form the Stock. The goal is to dismantle the pyramid by eliminating all 28 cards!"
autowrap_mode = 2

[node name="SecP2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Pairing Rules (Sum to 13)"

[node name="TextP2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Cards are eliminated in pairs that sum to exactly 13:\n• Ace = 1 pt  |  2-10 = Face value  |  Jack = 11 pts  |  Queen = 12 pts\n• King = 13 pts: Discards solo with a single tap!\n• Valid pairs: Queen + Ace (12+1), Jack + 2 (11+2), 10 + 3, 9 + 4, 8 + 5, 7 + 6."
autowrap_mode = 2

[node name="SecP3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Exposed Cards & Stacking"

[node name="TextP3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "A pyramid card is exposed and playable only when BOTH cards directly overlapping it in the row below have been removed. All 7 cards on the bottom row start fully exposed."
autowrap_mode = 2

[node name="SecP4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Stock, Waste & Recycles"

[node name="TextP4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Tap the Stock to deal cards to the Waste pile. The topmost Waste card is playable and can pair with exposed pyramid cards or discard as a King. When the Stock runs out, tap it to recycle the Waste (up to your pass limit)."
autowrap_mode = 2

[node name="SecP5" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Scoring & Winning"

[node name="TextP5" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentPyramid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Each removed card or pair awards 10 points. Clearing an entire row grants an escalating bonus (up to 250 pts for the apex). Dismantling the full pyramid earns a 500-point Victory Bonus!"
autowrap_mode = 2

