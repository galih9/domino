theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "All 4 arms (North, South, East, West) branching off the central [6-6] MUST have a tile played on them before ANY arm can be extended! Every tile played on the star must match a 6. If you hold no 6 during this opening phase, you must pass."
autowrap_mode = 2

[node name="SecSeb4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSebastopol"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
