text = "• Objective & Dealing"

[node name="Text1" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "A standard 28-tile double-six set is shuffled. Each player is dealt 7 tiles (or 6 tiles with 4 players). The remaining tiles form the Boneyard."
autowrap_mode = 2

[node name="Sec2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Turns & Placement"

[node name="Text2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "The player with the highest double starts the round. On your turn, play a tile from your hand whose pips match either open end of the domino train on the table. Doubles are placed crosswise."
autowrap_mode = 2

[node name="Sec3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Drawing & Passing"

[node name="Text3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "If you cannot play, you must draw tiles from the boneyard until you find a playable one. When the boneyard is empty, you must pass."
autowrap_mode = 2

[node name="Sec4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Scoring & Winning"

[node name="Text4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentClassic"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "The round ends when a player plays their last domino ('domino!'), or when the game is blocked with all players passing. The winner scores the sum of all pips remaining in opponents' hands."
autowrap_mode = 2

