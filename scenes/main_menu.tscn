[node name="TextS1" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Build all four suit foundations (♠, ♥, ♦, ♣) in ascending order from Ace up to King (A, 2, 3... 10, J, Q, K). Completing all four foundations wins the game!"
autowrap_mode = 2

[node name="SecS2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Tableau Cascades"

[node name="TextS2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Cards on the 7 tableau columns must be stacked in descending numerical sequence with alternating colors (e.g. Black 8 on Red 9, Red Queen on Black King). Only a King (or a pile starting with a King) can occupy an empty tableau column."
autowrap_mode = 2

[node name="SecS3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Stock & Waste Pile"

[node name="TextS3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Tap the Stock deck to deal cards into the Waste pile (1 card or 3 cards depending on deal mode). When the stock runs out, tap the empty stock slot to recycle the waste pile."
autowrap_mode = 2

[node name="SecS4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "• Controls & Shortcuts"

[node name="TextS4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentSolitaire"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "• Drag & Drop: Drag single cards or valid cascade stacks.\n• Tap / Click: Tap a card to auto-move it to foundations or valid tableau columns.\n• Double Click: Quick-send card straight to its foundation.\n• Auto-Finish: Once all hidden tableau cards are turned face-up, the Auto-Finish button appears to clear the rest home automatically!\n• Undo (↺) & Hint (💡): Full move history undo and smart move suggestions."
autowrap_mode = 2

