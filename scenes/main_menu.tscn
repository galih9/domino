theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "1. Play a card from your hand: If it matches the month of a card on the field, you capture both. If no match, it stays on the field.\n2. Draw top card from deck: Matches on field are captured; otherwise it stays on the field.\n3. Captured cards are categorized into Brights (Hikari), Animals (Tane), Ribbons (Tanzaku), and Plains (Kasu)."
autowrap_mode = 2

[node name="SecK3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentKoiKoi"]
