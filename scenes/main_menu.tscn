text = "- Yaku (Combinations & Points)"

[node name="TextK3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentKoiKoi"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "• Five Brights (Goko) - 10 pts: All 5 Bright cards\n• Four Brights (Shiko) - 8 pts: 4 Brights without Rainman\n• Rainy Four Brights (Ame-Shiko) - 7 pts: 4 Brights with Rainman\n• Three Brights (Sanko) - 5 pts: 3 Brights without Rainman\n• Inoshikacho - 5 pts: Boar + Deer + Butterflies (+1 per extra Animal)\n• Red Poetry Ribbons (Akatan) - 5 pts: 3 Red poetry ribbons (+1 per extra)\n• Blue Ribbons (Aotan) - 5 pts: 3 Blue ribbons (+1 per extra)\n• Viewing Yaku - 5 pts each: Moon Viewing (Moon+Cup) or Flower Viewing (Curtain+Cup)\n• Animals (Tane) - 1 pt: 5 Animals (+1 per extra)\n• Ribbons (Tanzaku) - 1 pt: 5 Ribbons (+1 per extra)\n• Plains (Kasu) - 1 pt: 10 Plains (+1 per extra, Sake Cup counts as Kasu)"
autowrap_mode = 2

[node name="SecK4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentKoiKoi"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Calling Koi-Koi vs STOP (Shoubu)"

[node name="TextK4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentKoiKoi"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "When you form or upgrade a Yaku, you must decide:\n• STOP (Shoubu): End the round immediately and claim your points.\n• KOI-KOI!: Continue playing to build higher score. Caution: If your opponent scores and calls STOP before you, they win and you get 0 points!\n• Multipliers: Any winning hand with 7+ points doubles (x2). Scoring after an opponent called Koi-Koi also doubles your score (x2)!"
autowrap_mode = 2

[node name="BtnCloseRules" type="Button" parent="RulesModal/Panel/VBox"]
custom_minimum_size = Vector2(0, 42)
