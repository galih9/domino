theme_override_font_sizes/font_size = 12
text = "Playing consecutive cards without drawing builds your Streak! Each card scores 10 × current streak (10, 20, 30...). Clearing peaks awards huge bonuses (1st peak: +150, 2nd peak: +250, 3rd peak: +500) and clearing all 28 cards awards a +1,000 Grand Victory Bonus!"
autowrap_mode = 2

[node name="SecT5" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentTriPeaks"]
