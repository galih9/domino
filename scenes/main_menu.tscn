theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Once all 4 arms are filled, the Star is complete! Normal block domino play continues clockwise. You can play on ANY of the 4 open branch ends. If you have no valid matching tile, you must pass."
