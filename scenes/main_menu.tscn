theme_override_font_sizes/font_size = 14
text = "- Objective & Dealing"

[node name="TextG1" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "A standard 52-card deck is shuffled. Each player is dealt 10 cards. One card is turned face-up to begin the Discard Pile; the remaining cards form the Stock Pile."
autowrap_mode = 2

[node name="SecG2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Melds: Sets & Runs"

[node name="TextG2" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "- Sets (Groups): 3 or 4 cards of the same rank (e.g. 7♥ 7♦ 7♠).\n- Runs (Sequences): 3 or more consecutive cards of the same suit (e.g. 4♣ 5♣ 6♣). Aces are strictly LOW (A-2-3 is valid; Q-K-A is not).\nEach card may only belong to one meld."
autowrap_mode = 2

[node name="SecG3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Deadwood & Knocking"

[node name="TextG3" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Cards not part of any meld count as Deadwood (Ace=1 pt, 2-9=face value, 10/J/Q/K=10 pts).\n- Knock: You may knock when discarding leaves 10 or fewer deadwood points.\n- GIN!: If all 10 cards form melds (0 deadwood), you declare GIN for a 25-point bonus!"
autowrap_mode = 2

[node name="SecG4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.8, 0.38, 1)
theme_override_font_sizes/font_size = 14
text = "- Defender Layoffs & Undercut"

[node name="TextG4" type="Label" parent="RulesModal/Panel/VBox/ScrollContainer/ContentGinRummy"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "If the knocker did not declare Gin, the defender may lay off deadwood cards onto the knocker's melds!\n- If Knocker deadwood < Defender deadwood: Knocker wins the difference in points.\n- If Defender deadwood <= Knocker deadwood: This is an UNDERCUT! Defender wins 25 bonus points + deadwood difference!\nFirst to reach match target score wins the match."
autowrap_mode = 2

